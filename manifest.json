{
  "manifest_version": "0.2",
  "name": "synter",
  "version": "1.3.0",
  "display_name": "Synter",
  "description": "Stdio bridge to Synter's dynamically discovered hosted MCP catalog for agentic advertising workflows.",
  "author": {
    "name": "Synter",
    "email": "hello@syntermedia.ai",
    "url": "https://syntermedia.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Synter-Media-AI/mcp-server"
  },
  "homepage": "https://syntermedia.ai",
  "license": "MIT",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "SYNTER_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Synter API Key",
      "description": "Your Synter API key from syntermedia.ai/developer",
      "required": true,
      "sensitive": true
    }
  }
}
