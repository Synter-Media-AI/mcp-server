{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Synter-Media-AI/synter-ads",
  "description": "Dynamic stdio bridge to Synter's hosted agentic advertising tool catalog.",
  "status": "active",
  "repository": {
    "url": "https://github.com/Synter-Media-AI/mcp-server",
    "source": "github"
  },
  "version": "1.3.0",
  "icons": [
    {
      "src": "https://syntermedia.ai/brand/android-chrome-192x192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@synterai/mcp-server",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SYNTER_API_KEY",
          "description": "Your Synter API key. Get one at https://syntermedia.ai/developer",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.syntermedia.ai/mcp/"
    }
  ]
}
