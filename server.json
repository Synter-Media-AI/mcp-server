{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Synter-Media-AI/synter-ads",
  "description": "Execute campaigns on 30+ ad platforms from Claude, Cursor or Codex; pay only when Synter acts.",
  "status": "active",
  "repository": {
    "url": "https://github.com/Synter-Media-AI/mcp-server",
    "source": "github"
  },
  "version": "1.5.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@synterai/mcp-server",
      "version": "1.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SYNTER_API_KEY",
          "description": "Your Synter API key. Create one at https://synterai.com/developer",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.synterai.com"
    }
  ],
  "websiteUrl": "https://synterai.com/mcp"
}
