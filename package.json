{
  "name": "@synterai/mcp-server",
  "version": "1.3.0",
  "mcpName": "io.github.Synter-Media-AI/synter-ads",
  "description": "Dynamic stdio bridge to Synter's complete hosted MCP catalog for agentic advertising.",
  "author": "Synter <hello@syntermedia.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Synter-Media-AI/mcp-server.git"
  },
  "homepage": "https://syntermedia.ai/manual",
  "bugs": {
    "url": "https://github.com/Synter-Media-AI/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "advertising",
    "ad-management",
    "cross-platform-ads",
    "google-ads",
    "meta-ads",
    "facebook-ads",
    "linkedin-ads",
    "microsoft-ads",
    "reddit-ads",
    "tiktok-ads",
    "campaign-management",
    "ppc",
    "ppc-automation",
    "media-buying",
    "marketing-automation",
    "ad-creative",
    "claude",
    "cursor",
    "amp",
    "chatgpt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "synter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "validate:discovery": "node ./scripts/validate-discovery.mjs",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build && npm run validate:discovery && npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
