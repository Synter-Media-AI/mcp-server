{
  "name": "@synterai/mcp-server",
  "version": "1.4.6",
  "mcpName": "io.github.Synter-Media-AI/synter-ads",
  "description": "Open-source MCP server for running ads with AI agents across 43 ad platforms (16 in local stdio): free reads ($0.00/mo), $20/mo Solo ($20/mo usage value included; $0.05-$0.25 writes), 0% of ad spend.",
  "author": "Synter <hello@synterai.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Synter-Media-AI/mcp-server.git"
  },
  "homepage": "https://synterai.com/mcp",
  "bugs": {
    "url": "https://github.com/Synter-Media-AI/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "advertising",
    "ad-management",
    "cross-platform-ads",
    "google-ads",
    "meta-ads",
    "facebook-ads",
    "ad-reporting",
    "roas",
    "marketing-analytics",
    "linkedin-ads",
    "microsoft-ads",
    "reddit-ads",
    "tiktok-ads",
    "stackadapt",
    "campaign-management",
    "ppc",
    "ppc-automation",
    "media-buying",
    "marketing-automation",
    "ad-creative",
    "claude",
    "cursor",
    "amp",
    "chatgpt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "synter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate:discovery": "node ./scripts/validate-discovery.mjs",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
